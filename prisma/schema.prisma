// ApplyPilot database schema.
//
// The four auth models below mirror the table definitions Better Auth 1.7.2
// reports for this exact configuration (email + password, Google social
// provider, account linking). They were derived from the library's own
// `getAuthTables()` metadata rather than copied from an example, so every
// column — including `Account.issuer`, which older guides do not have — matches
// what the running adapter expects.
//
// When you upgrade Better Auth, re-derive the tables and diff them against this
// file before migrating.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth — owned by the library. Do not add product columns here; hang
// product data off `User.id` from your own models instead (see the note at the
// bottom of this file).
// ---------------------------------------------------------------------------

/// Ids are generated by Better Auth, so there is deliberately no `@default`.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions          Session[]
  accounts          Account[]
  savedJobs         SavedJob[]
  applications      Application[]
  applicationEvents ApplicationEvent[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Holds both the local credential account (`providerId = "credential"`, with
/// the scrypt password hash Better Auth manages) and linked OAuth accounts.
model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("accounts")
}

/// Short-lived tokens: email verification and password reset.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Product models
// ---------------------------------------------------------------------------

/// A job the signed-in user shortlisted from the discovery feed.
///
/// This is the reference shape for every future product table (applications,
/// user preferences, ...): own the row through `userId -> User.id`, cascade on
/// user deletion, and index the owner column.
model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  /// Identifier of the listing in the job feed.
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@map("saved_jobs")
}

// ---------------------------------------------------------------------------
// Application tracker
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

/// Contract types, chosen from a list so the board can filter on them.
/// Labels shown in the UI carry the French equivalent where there is one.
enum EmploymentType {
  FULL_TIME
  FIXED_TERM
  APPRENTICESHIP
  INTERNSHIP
  FREELANCE
  PART_TIME
}

/// Where a row came from. `APPLYPILOT` means it started life in the job feed.
enum ApplicationSource {
  MANUAL
  APPLYPILOT
}

/// One opportunity the user is tracking, from shortlist through to offer.
///
/// Every query in `lib/applications/` filters on `userId`; the value always
/// comes from the server-side session, never from the browser.
model Application {
  id             String            @id @default(cuid())
  userId         String
  companyName    String
  companyDomain  String?
  companyLogoUrl String?
  jobTitle       String
  jobUrl         String?
  location       String?
  workMode       WorkMode?
  employmentType EmploymentType?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?
  status         ApplicationStatus @default(SAVED)
  source         ApplicationSource @default(MANUAL)
  contactName    String?
  contactEmail   String?
  appliedAt      DateTime?
  interviewAt    DateTime?
  followUpAt     DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  events ApplicationEvent[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, appliedAt])
  @@index([userId, employmentType])
  @@map("applications")
}

/// Append-only history so a status can be audited and never silently rewound.
model ApplicationEvent {
  id            String             @id @default(cuid())
  applicationId String
  userId        String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  /// "user", "gmail-import", ... — who caused the move.
  actor         String             @default("user")
  note          String?
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([userId])
  @@map("application_events")
}
