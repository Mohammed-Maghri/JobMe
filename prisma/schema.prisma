// ApplyPilot database schema.
//
// The four auth models below mirror the table definitions Better Auth 1.7.2
// reports for this exact configuration (email + password, Google social
// provider, account linking). They were derived from the library's own
// `getAuthTables()` metadata rather than copied from an example, so every
// column — including `Account.issuer`, which older guides do not have — matches
// what the running adapter expects.
//
// When you upgrade Better Auth, re-derive the tables and diff them against this
// file before migrating.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth — owned by the library. Do not add product columns here; hang
// product data off `User.id` from your own models instead (see the note at the
// bottom of this file).
// ---------------------------------------------------------------------------

/// Ids are generated by Better Auth, so there is deliberately no `@default`.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  savedJobs SavedJob[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Holds both the local credential account (`providerId = "credential"`, with
/// the scrypt password hash Better Auth manages) and linked OAuth accounts.
model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("accounts")
}

/// Short-lived tokens: email verification and password reset.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Product models
// ---------------------------------------------------------------------------

/// A job the signed-in user shortlisted from the discovery feed.
///
/// This is the reference shape for every future product table (applications,
/// user preferences, ...): own the row through `userId -> User.id`, cascade on
/// user deletion, and index the owner column.
model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  /// Identifier of the listing in the job feed.
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@map("saved_jobs")
}
