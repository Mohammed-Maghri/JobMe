# --- Database -----------------------------------------------------------
# PostgreSQL connection string used by Prisma and, through it, Better Auth.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/applypilot?schema=public"

# --- Better Auth --------------------------------------------------------
# Signs session cookies and tokens. Generate with:
#   openssl rand -base64 32
# Rotating this value invalidates every existing session.
BETTER_AUTH_SECRET=""

# Public origin of this app. Must match the OAuth redirect URI host exactly.
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth -------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials.
# Leave both empty to run the app without Google sign-in; the button hides
# itself and email/password keeps working.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
